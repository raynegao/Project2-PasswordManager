{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01 创建演示密码库",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "init"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "02 添加 GitHub 账号",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "add",
        "github",
        "demo-user",
        "--generate",
        "24"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "03 列出账号",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "list"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "04 查看 GitHub 密码",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "show",
        "github"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "05 生成 24 位密码",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "generate",
        "--length",
        "24"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "06 Bonus：生成队友密钥",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "keygen",
        "--private",
        "local/presentation-private.pem",
        "--public",
        "local/presentation-public.pem"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "07 Bonus：分享 GitHub 账号",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "share",
        "github",
        "--public-key",
        "local/presentation-public.pem",
        "--out",
        "local/presentation.share.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "08 Bonus：解密分享文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "unshare",
        "local/presentation.share.json",
        "--private-key",
        "local/presentation-private.pem"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "09 删除 GitHub 账号",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "remove",
        "github"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "10 修改主密码",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": [
        "--vault",
        "local/presentation.vault.json",
        "change-master"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "11 运行全部测试",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
